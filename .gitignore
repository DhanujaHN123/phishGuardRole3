# Dependencies & Python virtual environments
vendor/
__pycache__/
*.pyc
*.pyo
*.pyd
*.whl

# Large dataset archives & raw CSVs (> 50MB)
data/*.zip
data/**/*.csv

# IDE & OS temporary files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Role 3 DOM dataset: keep labeled CSVs and the schema in Git, but never the raw HTML snapshots
# (phishing pages: large, and unsafe to redistribute).
!data/dom/*.csv
data/dom/snapshots/
data/dom/dom_features*.csv
node_modules/
!data/dom/dom_labeled.csv
